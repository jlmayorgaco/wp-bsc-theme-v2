includes:
	- tools/php-vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 0
	parallel:
		maximumNumberOfProcesses: 1
	paths:
		- admin
		- components
		- emails
		- inc
		- includes
		- plugins
		- scripts
		- woocommerce
		- functions.php
		- page-login.php
		- page-register.php
		- template-bsc-shop-landing.php
		- front-page.php
		- helpers

	bootstrapFiles:
		- phpstan-bootstrap.php
		- tools/php-vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- tools/php-vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php

	excludePaths:
		analyse:
			- node_modules
			- tools/php-vendor
			- vendor
			- test-results
			- playwright-report
			- tests/e2e/fixtures

	treatPhpDocTypesAsCertain: false
