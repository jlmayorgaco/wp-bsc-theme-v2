{
  "name": "bubbleskincare/wp-bsc-theme-v2",
  "type": "wordpress-theme",
  "description": "Custom WordPress and WooCommerce theme for Bubble Skin Care.",
  "keywords": [
    "WordPress",
    "WooCommerce",
    "Bubble Skin Care"
  ],
  "homepage": "https://bubbleskincare.co",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Bubble Skin Care",
      "homepage": "https://bubbleskincare.co"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2",
    "wp-cli/i18n-command": "^2.6"
  },
  "scripts": {
    "lint:php": "parallel-lint --exclude .git --exclude vendor --exclude node_modules --exclude test-results --exclude playwright-report .",
    "lint:wpcs": "phpcs -d memory_limit=512M --standard=phpcs.xml.dist",
    "lint:phpstan": "phpstan analyse --configuration=phpstan.neon",
    "lint:quality": [
      "@lint:php",
      "@lint:wpcs",
      "@lint:phpstan"
    ],
    "make-pot": "wp i18n make-pot . languages/bsc-2-0.pot --domain=bsc-2-0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "bin-dir": "tools/php-vendor/bin",
    "vendor-dir": "tools/php-vendor",
    "sort-packages": true
  },
  "support": {
    "source": "https://github.com/bubbleskincare/wp-bsc-theme-v2"
  }
}
